<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Entry</title>
</head>
<body>
    <h1>New Entry Page</h1>
    <form method="post" action="/entries/new">
        <label for="title">Title:</label>
        <input name="title" id="title" type="text">

        <label for="entryBody">Entry:</label>
        <input name="entryBody" id="entryBody" type="text">
        
        <label for="isPublic">Is Public?</label>
        <input name="isPublic" id="isPublic" type="checkbox">
    
        <button>Submit Entry</button>
    
    </form>
</body>
</html>